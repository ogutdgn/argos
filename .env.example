# Copy to .env and fill in. Never commit .env.
# Contract (tables, buckets, processing endpoint): docs/structure.md

# --- Web (web/, Vercel) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS: magic-link form and conversation processing.
SUPABASE_SECRET_KEY=
# Same value as the station's. Checked by POST /api/conversations/process.
STATION_API_SECRET=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Base URL used in magic links, e.g. https://<app>.vercel.app
NEXT_PUBLIC_SITE_URL=
# W0.2 plan page: reads GitHub issues. Server only.
GITHUB_TOKEN=

# --- Station (station/, MacBook) ------------------------------------------
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Base URL of the web app, e.g. https://<app>.vercel.app
ARGOS_WEB_URL=
STATION_API_SECRET=
